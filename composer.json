{
  "name": "wamesk/laravel-nova-action-toolbar",
  "description": "Choose per Laravel Nova action how it is shown: a button, an icon or the ⋯ menu — on the index, in table rows and on the detail.",
  "type": "library",
  "license": "proprietary",
  "version": "4.0.1",
  "repositories": [
    {
      "type": "composer",
      "url": "https://nova.laravel.com"
    }
  ],
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "laravel/nova": "^4.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0|^10.0",
    "pestphp/pest": "^2.33|^3.0"
  },
  "autoload": {
    "psr-4": {
      "Wame\\LaravelNovaActionToolbar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wame\\LaravelNovaActionToolbar\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Wame\\LaravelNovaActionToolbar\\ActionToolbarServiceProvider"
      ]
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "scripts": {
    "test": "pest"
  }
}
